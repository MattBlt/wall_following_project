<?xml version="1.0"?>
<package format="3">
  <name>limo_wf_sim</name>
  <version>0.1.0</version>
  <description>Modello e mondo Gazebo per il wall following su AgileX LIMO</description>
  <maintainer email="baltieri.mattia04@gmail.com">Mattia Baltieri</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export><build_type>ament_cmake</build_type></export>
</package>