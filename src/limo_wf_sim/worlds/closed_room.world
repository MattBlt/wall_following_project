<?xml version="1.0" ?>
<!--
  Closed room, walls 0.15 m thick, 0.5 m high. Centreline polygon (clockwise):
  (0,0) -> (5,0) -> (5,3) -> (9,3) -> (12,0) -> (12,-5) -> (7,-5) -> (7,-8) -> (0,-8) -> (0,0)
  wall4 is the 45 deg diagonal (+3 x, -3 y), true length 4.243 m.
  Each box is centred on its centreline segment and drawn one thickness (0.15 m) longer than the
  segment, i.e. 0.075 m of overrun per end, so the outer corners are filled instead of notched.
  Interior is BELOW y=0 near the origin.
-->
<sdf version="1.6">
  <world name="default">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- Chase camera. The initial <pose> frames the whole room; <track_visual> is what makes the
         camera glue itself to the robot: 2.5 m behind it and 5 m up, so the view is nearly top-down
         with a slight tilt, always aimed at the robot.
         inherit_yaw=true rotates with the robot (chase cam); set it to false to keep the room's
         orientation fixed and have the camera only translate.
         The robot is spawned after the world loads, so sim.launch.py triggers the follow with
         `gz camera -c user_camera -f limo_gazebo` a few seconds in. -->
    <gui>
      <camera name="user_camera">
        <pose>6 -14 14 0 0.883 1.571</pose>
        <track_visual>
          <name>limo_gazebo</name>
          <static>true</static>
          <use_model_frame>true</use_model_frame>
          <xyz>-2.5 0 5</xyz>
          <inherit_yaw>true</inherit_yaw>
        </track_visual>
      </camera>
    </gui>

    <model name="walls">
      <static>true</static>

      <link name="wall1">
        <pose>2.5 0 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>5.15 0.15 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5.15 0.15 0.5</size></box></geometry></visual>
      </link>

      <link name="wall2">
        <pose>5 1.5 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.15 3.15 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 3.15 0.5</size></box></geometry></visual>
      </link>

      <link name="wall3">
        <pose>7 3 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>4.15 0.15 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4.15 0.15 0.5</size></box></geometry></visual>
      </link>

      <link name="wall4">
        <pose>10.5 1.5 0.25 0 0 -0.785398</pose>
        <collision name="collision"><geometry><box><size>4.4 0.15 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4.4 0.15 0.5</size></box></geometry></visual>
      </link>

      <link name="wall5">
        <pose>12 -2.5 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.15 5.15 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 5.15 0.5</size></box></geometry></visual>
      </link>

      <link name="wall6">
        <pose>9.5 -5 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>5.15 0.15 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>5.15 0.15 0.5</size></box></geometry></visual>
      </link>

      <link name="wall7">
        <pose>7 -6.5 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.15 3.15 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 3.15 0.5</size></box></geometry></visual>
      </link>

      <link name="wall8">
        <pose>3.5 -8 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>7.15 0.15 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>7.15 0.15 0.5</size></box></geometry></visual>
      </link>

      <link name="wall9">
        <pose>0 -4 0.25 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.15 8.15 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 8.15 0.5</size></box></geometry></visual>
      </link>

    </model>
  </world>
</sdf>
